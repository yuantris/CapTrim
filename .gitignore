# Rust
/target/
**/*.rs.bk
Cargo.lock.bak

# Native build outputs. Everything here is regenerated by scripts/build-*.sh,
# so only sources are committed: a checked-in .so goes stale silently.
/dist/
/platforms/android/captrim/src/main/jniLibs/
/platforms/ohos/captrim/libs/
/native/build/

# Prebuilt FFmpeg trees (source archives are downloaded, never committed)
/third_party/
/ffmpeg-*/

# Android
.gradle/
/platforms/android/build/
/platforms/android/*/build/
/platforms/android/local.properties
*.aar
*.apk
captures/

# HarmonyOS / DevEco
.hvigor/
.cache/
.idea/
/oh_modules/
**/oh_modules/
**/build/default/
*.har
*.hsp
*.hap
local.properties
.cxx/
obfuscation-rules.txt.bak

# Editors / OS
.vscode/
.DS_Store
Thumbs.db
*.swp

# Patch artifacts
*.orig
*.rej
