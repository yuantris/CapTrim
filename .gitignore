# Rust
/target/
**/*.rs.bk
Cargo.lock.bak

# Native build outputs. Everything here is regenerated by scripts/build-*.sh,
# so only sources are committed: a checked-in .so goes stale silently.
/dist/
/platforms/android/captrim/src/main/jniLibs/
/platforms/ohos/captrim/libs/
/native/build/

# Prebuilt FFmpeg trees (source archives are downloaded, never committed)
/third_party/
/ffmpeg-*/

# Android
.gradle/
/platforms/android/build/
/platforms/android/*/build/
/platforms/android/local.properties
*.aar
*.apk
captures/

# HarmonyOS / DevEco
.hvigor/
.cache/
.idea/
/oh_modules/
**/oh_modules/
**/build/default/
*.har
*.hsp
*.hap
local.properties
.cxx/
obfuscation-rules.txt.bak
# Sample media is injected at build time by scripts/build-ohos-hap.sh, never
# committed: it is a 20 MB video, and a test asset that size does not belong in git.
/platforms/ohos/entry/src/main/resources/rawfile/

# Written by the IDE on sync, not by hand
.clangd
.clang-tidy
**/BuildProfile.ets

# Editors / OS
.vscode/
.DS_Store
Thumbs.db
*.swp

# Scratch space for device runs (layout dumps, screenshots pulled with hdc)
/.tmp/

# FFmpeg cross-build trees and their configure/build logs. Regenerated by
# scripts/build-ffmpeg-*.sh; can exceed 1 GB for the three ABIs.
/build/

# Local agent working notes (device logs, task journal). Not part of the SDK.
/.workbuddy/

# Patch artifacts
*.orig
*.rej
